{
  "name": "vibechart",
  "version": "0.2.0",
  "description": "Dependency-free, framework-free financial charting library in pure TypeScript/Canvas 2D: 18 chart types, 91 drawing tools, 173 technical indicators, a Python strategy editor with a TradingView-style Strategy Tester, lazy history loading, multi-pane layouts, themes and a full trading-terminal UI. TradingView-compatible datafeed API.",
  "main": "./dist/vibechart.umd.js",
  "module": "./dist/vibechart.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/vibechart.umd.js",
  "jsdelivr": "./dist/vibechart.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vibechart.mjs",
      "require": "./dist/vibechart.umd.js",
      "default": "./dist/vibechart.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && tsc -p tsconfig.types.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "chart",
    "charting",
    "charting-library",
    "trading",
    "candlestick",
    "candlestick-chart",
    "financial-charts",
    "stock-chart",
    "tradingview",
    "canvas",
    "technical-analysis",
    "indicators",
    "drawing-tools",
    "finance",
    "typescript",
    "no-dependencies",
    "backtesting",
    "strategy-tester",
    "python",
    "pyodide",
    "algo-trading"
  ],
  "author": "Calvin Kei",
  "license": "MIT",
  "homepage": "https://github.com/calvinkei/vibechart#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/calvinkei/vibechart.git"
  },
  "bugs": {
    "url": "https://github.com/calvinkei/vibechart/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
